# Environment variables for the API server. All optional for the demo.
# The server reads process.env directly (no dotenv), so export them in your shell
# or run: npx tsx --env-file=.env server/index.ts
PORT=8787

# Ticket scanning (Gemini vision). Without a key the app falls back to a short manual form.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
